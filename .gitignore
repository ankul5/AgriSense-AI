# Environment and Secret configuration files
.env
*.env
backend/.env

# Python compilation and cache
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# ML: exported model weights (ONNX) — downloaded from Drive after Colab
# training (plant-disease-implementation-plan.md Phase G), not committed.
serving/models/
ml/notebooks/.ipynb_checkpoints/

# Build artifacts & Android App Bundles / Packages
*.aab
*.apk

# IDE and OS metadata files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tooling state — regenerated automatically, never belongs in the repo.
# .expo is recreated by `expo start`; .claude holds per-machine Claude Code
# permission settings that are personal to whoever cloned this.
.expo/
.claude/

# Node dependencies (mobile_app / web_dashboard)
node_modules/

# Papers, posters and other non-code documents live outside the repo
paper/
*.docx
*.pdf
